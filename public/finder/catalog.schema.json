{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "title",
          "category",
          "answer",
          "scope",
          "limitation",
          "lifecycle",
          "availability",
          "aliases",
          "questions",
          "demo",
          "sources",
          "review"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "enum": [
              "implemented",
              "experimental",
              "planned",
              "unverified"
            ]
          },
          "availability": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "demo": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "href"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "href": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^/(?!/)[a-z0-9/#-]+$"
                  }
                }
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "href"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^/(?!/)[a-z0-9/#-]+$"
                }
              }
            },
            "minItems": 1
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "basis",
              "checkedOn"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "checkedOn": {
                "type": "string",
                "minLength": 1,
                "format": "date"
              }
            }
          }
        }
      },
      "minItems": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlasade public capability catalog v1"
}
