{
  "name": "atlasade-public-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/sync-pages-root.mjs && node scripts/build-public.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:preview": "npm run build && node scripts/prepare-preview.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build:preview && npm test"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "framer-motion": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "wrangler": "4.152.0"
  }
}
